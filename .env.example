# Supabase Configuration
# CRITICAL: Get these values from your Supabase project dashboard
# NEVER commit the actual .env file with real credentials!
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Security Settings
# Enable additional security features in production
VITE_ENVIRONMENT=development
VITE_ENABLE_DEBUG_LOGS=true
VITE_SESSION_TIMEOUT=3600
VITE_MAX_LOGIN_ATTEMPTS=5

# Rate Limiting (requests per minute)
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60

# Storage Encryption
# Generate a secure random key for encrypting sensitive data in localStorage
# Use: openssl rand -hex 32
# IMPORTANT: Keep this secret and rotate it periodically
# If not set, a session-specific key will be generated automatically
VITE_STORAGE_ENCRYPTION_KEY=your_64_character_hex_string_here

# Error Tracking (Sentry)
# Get your DSN from https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_ENABLE_SENTRY=true
VITE_APP_VERSION=1.0.0

# Sentry Source Maps (for production builds only)
# Auth token from: https://sentry.io/settings/account/api/auth-tokens/
VITE_SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project

# For local development with Supabase CLI, use these values:
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=your_local_anon_key
