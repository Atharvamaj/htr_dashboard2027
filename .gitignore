.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local

# Explicitly allow example files
!.env.example
!.env.sample

# Backup files (in case someone creates backups)
.env.backup
.env.bak
*.env.backup
*.env.bak

